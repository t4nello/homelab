// ============================================================
// LOGI DO LOKI
// ============================================================

discovery.kubernetes "pods" {
  role = "pod"
}

discovery.relabel "pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

loki.source.kubernetes "pod_logs" {
  targets    = discovery.relabel.pod_logs.output
  forward_to = [loki.process.pod_logs.receiver]
}

loki.process "pod_logs" {
  stage.cri {}

  forward_to = [
    loki.write.local_loki.receiver,
  ]
}

loki.write "local_loki" {
  endpoint {
    url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
  }
}


// ============================================================
// METRYKI DO PROMETHEUSA
// ============================================================

prometheus.exporter.unix "node_exporter" {
  rootfs_path = "/host/root"
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"

  filesystem {
    fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|squashfs|sysfs|tmpfs)$"
    mount_points_exclude = "^/([^s].*|s([^r].*)?|sr([^v].*)?|srv.+)$"
  }
}

prometheus.scrape "node_exporter" {
  scrape_interval = "15s"
  targets         = prometheus.exporter.unix.node_exporter.targets

  forward_to = [
    prometheus.relabel.global_k8s.receiver,
  ]

  job_name = "node-exporter"
}

prometheus.scrape "kube_state_metrics" {
  scrape_interval = "15s"

  targets = [
    {
      "__address__" = "kube-state-metrics.monitoring.svc:8080",
    },
  ]

  forward_to = [
    prometheus.relabel.global_k8s.receiver,
  ]
}

prometheus.scrape "kubelet" {
  scrape_interval = "15s"
  scheme          = "https"
  metrics_path    = "/metrics/cadvisor"

  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"

  tls_config {
    ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = true
  }

  targets = [
    {
      "__address__" = sys.env("NODE_IP") + ":10250",
    },
  ]

  forward_to = [
    prometheus.relabel.global_k8s.receiver,
  ]
}


// ============================================================
// METRYKI Z PODÓW Z ANNOTACJĄ prometheus.io/scrape
// ============================================================

discovery.relabel "annotated_pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    action        = "keep"
    regex         = "true"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_host_network"]
    action        = "drop"
    regex         = "true"
  }

  rule {
    source_labels = ["__address__", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
    action        = "replace"
    regex         = "^([^:]+)(?::\\d+)?;(\\d+)$"
    replacement   = "$1:$2"
    target_label  = "__address__"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    action        = "replace"
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

prometheus.scrape "pod_metrics" {
  scrape_interval = "15s"
  targets         = discovery.relabel.annotated_pods.output

  forward_to = [
    prometheus.relabel.global_k8s.receiver,
  ]
}

prometheus.scrape "watchyourlan" {
  scrape_interval = "30s"

  targets = [
    {
      "__address__" = "watchyourlan.monitoring.svc:8840",
      "job"         = "watchyourlan",
    },
  ]

  metrics_path = "/metrics"

  forward_to = [
    prometheus.relabel.global_k8s.receiver,
  ]
}


// ============================================================
// WSPÓLNY RELABELING METRYK K8S
// ============================================================

prometheus.relabel "global_k8s" {
  forward_to = [
    prometheus.remote_write.local_prom.receiver,
  ]

  rule {
    action      = "replace"
    replacement = "k3s"
    target_label = "cluster"
  }

  rule {
    source_labels = ["nodename"]
    regex         = "^$"
    replacement   = sys.env("HOSTNAME")
    target_label  = "nodename"
  }
}


// ============================================================
// REMOTE WRITE DO PROMETHEUSA
// ============================================================

prometheus.remote_write "local_prom" {
  endpoint {
    url = "http://prometheus.monitoring.svc:9090/api/v1/write"
  }
}


// ============================================================
// METRYKI Z OPENWRT
// ============================================================

prometheus.scrape "openwrt" {
  scrape_interval = "15s"

  targets = [
    {
      "__address__" = "192.168.1.2:9100",
      "instance"    = "openwrt",
      "job"         = "openwrt",
    },
  ]

  forward_to = [
    prometheus.relabel.openwrt.receiver,
  ]
}

prometheus.relabel "openwrt" {
  forward_to = [
    prometheus.remote_write.local_prom.receiver,
  ]

  rule {
    source_labels = ["ifname"]
    regex         = "phy0-ap0"
    target_label  = "ifname"
    replacement   = "2.4GHz"
  }

  rule {
    source_labels = ["ifname"]
    regex         = "phy1-ap0"
    target_label  = "ifname"
    replacement   = "5GHz"
  }
}

// ============================================================
// LOGI Z OPENWRT (SYSLOG)
// ============================================================

loki.source.syslog "openwrt_syslog" {
  listener {
    address  = "0.0.0.0:5140"
    protocol = "udp"
    syslog_format = "rfc3164"
    labels   = {
      namespace = "monitoring",
      container = "openwrt",
    }
  }

  forward_to = [
    loki.write.local_loki.receiver,
  ]
}